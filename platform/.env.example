# =============================================================================
# OCEAN BLUE — PLATFORM ENVIRONMENT VARIABLES
# =============================================================================
# Copy to .env and fill in your values. NEVER commit .env to any repository.
#
# This file covers the PLATFORM side (public repo). For the algorithm side,
# see signal_engine/.env.example.
#
# Phase 1 (paper trading, GitHub Pages only): no variables required
# Phase 2 (lawyer review in progress):        Bitbucket auth for GitHub Actions
# Phase 3 (commercial launch):                Stripe + SendGrid + Twilio
# =============================================================================


# ─── PHASE 2: Cross-service git auth (REQUIRED for daily.yml) ────────────────
# These live as GitHub Repository Secrets, not in a local .env.
# Set at: GitHub → ocean-blue repo → Settings → Secrets and variables → Actions
#
# BITBUCKET_USER         — your Bitbucket username
# BITBUCKET_APP_PASSWORD — read-only App Password from Bitbucket
#                          (Bitbucket → Personal Settings → App Passwords →
#                           Create new, permissions: Repositories: Read only)


# ─── PHASE 3: Stripe billing ─────────────────────────────────────────────────
# Sign up: stripe.com → Activate account (business verification, 1-2 days)
# Create product: Dashboard → Products → New
#   Name:  "Ocean Blue Monthly"
#   Price: $20.00 USD, recurring monthly
# Copy the price_xxx ID into STRIPE_PRICE_ID below.

STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME              # $20/mo base subscription
STRIPE_SMS_PRICE_ID=price_REPLACE_ME          # $5/mo optional SMS add-on

# For development/testing, use test keys (sk_test_..., pk_test_...).
# Switch to live keys only after legal sign-off + end-to-end test transactions.


# ─── PHASE 3: SendGrid email delivery ────────────────────────────────────────
# Sign up: sendgrid.com (free tier: 100 emails/day forever)
# CRITICAL: complete domain authentication (DKIM/SPF/DMARC) before sending —
# otherwise emails will land in spam at Gmail/Outlook/Yahoo.
# Setup: SendGrid → Settings → Sender Authentication → Authenticate Your Domain

SENDGRID_API_KEY=SG.REPLACE_ME
SEND_FROM_EMAIL=signals@oceanblue.example.com
SEND_FROM_NAME=Ocean Blue


# ─── PHASE 3: Twilio SMS delivery ────────────────────────────────────────────
# Sign up: twilio.com
# Buy a phone number (~$1/mo) at: Console → Phone Numbers → Buy a number
# REQUIRED before sending any US commercial SMS: A2P 10DLC registration
#   Brand registration:    $4 one-time
#   Campaign registration: $10/mo + $15 vetting fee
#   Lead time:             1-3 weeks (start early)
# Setup: Twilio Console → Messaging → Regulatory Compliance → A2P 10DLC

TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_FROM_NUMBER=+15555551234


# ─── PHASE 3: Site URLs ──────────────────────────────────────────────────────
# Used in email templates and Stripe redirect URLs.

SITE_URL=https://oceanblue.example.com
SUPPORT_EMAIL=support@oceanblue.example.com


# ─── PHASE 3: Database (when you wire it up) ─────────────────────────────────
# Recommended: Supabase (Postgres, free tier 500MB) or Neon (free tier 0.5GB)
# Format: postgres://user:password@host:port/database

DATABASE_URL=postgres://user:password@localhost:5432/oceanblue


# ─── Operational flags ───────────────────────────────────────────────────────
# Set DRY_RUN=true to test the daily pipeline without sending notifications
# or charging subscribers. Useful during Phase 2 testing.

DRY_RUN=false

# Set MAINTENANCE_MODE=true to display a maintenance banner on the site.
MAINTENANCE_MODE=false

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
