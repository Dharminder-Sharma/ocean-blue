# Ocean Blue Signal Engine — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to any repository.

# === Required ===
TIINGO_API_KEY=your_tiingo_api_key_here

# Path to the local clone of the private ocean-blue-signals repository.
# This folder's git origin should be set to your Bitbucket repo, e.g.:
#   git clone git@bitbucket.org:bestkind/ocean-blue-signals.git
# signal_engine.py will write signal.json here and git push to Bitbucket.
SIGNALS_REPO_PATH=/Users/ted/ocean-blue-signals

# === Optional ===
# Where the engine stores its internal state and logs
ENGINE_DATA_DIR=/Users/ted/signal-engine-workspace/qqq_v34_data

# Hard kill switch (set to true to halt all signal generation)
TRADING_HALT=false

# Phase per memory #20: SILENT | ALERT_ONLY | CONFIRM | SEMI_AUTO
TRADING_MODE=ALERT_ONLY

# Paper trading capital
PAPER_TRADING=true
PAPER_START_CAPITAL=100000
